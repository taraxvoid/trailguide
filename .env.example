# RapidAPI key for JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=

# Adzuna developer app credentials (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Ollama host/model for `trailguide tailor` (resume tailoring). Both are optional -
# defaults are 127.0.0.1:11434 and qwen3:8b. OLLAMA_HOST accepts either a
# bare host:port or a full URL, matching Ollama's own CLI convention.
OLLAMA_HOST=
OLLAMA_MODEL=

# Optional overrides (see README "Configuration"): where the sqlite db lives, and a
# config file to use instead of the global config plus ./trailguide.toml.
TRAILGUIDE_DB=
TRAILGUIDE_CONFIG=
