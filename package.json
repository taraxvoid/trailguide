{
  "name": "igor",
  "version": "0.1.0",
  "description": "A minion to find software engineering jobs",
  "type": "module",
  "keywords": [],
  "private": true,
  "author": "Tara <1711810+taraxvoid@users.noreply.github.com>",
  "license": "MIT",
  "bin": {
    "igor": "./src/cli.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "postinstall": "bunx @biomejs/biome migrate --write",
    "smoke-live": "bun run tests/smoke-live.ts",
    "check:licenses": "bun scripts/check-licenses.ts",
    "tui": "bun run src/cli.ts tui"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@lizenz/checker": "^0.0.2",
    "@types/bun": "^1.1.14",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
